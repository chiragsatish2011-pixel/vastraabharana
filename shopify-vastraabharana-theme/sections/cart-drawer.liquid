<div id="vastra-cart-drawer" class="fixed inset-0 z-50 overflow-y-auto bg-white text-neutral-900 select-none hidden animate-in fade-in duration-200">
  
  <!-- Subtle Warm Brand Aura -->
  <div class="fixed inset-0 bg-[radial-gradient(ellipse_at_50%_0%,rgba(249,115,22,0.03)_0%,transparent_70%)] pointer-events-none"></div>

  <!-- Top Sticky Header -->
  <div class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-neutral-200/80 px-6 sm:px-12 py-4 flex items-center justify-between shadow-xs">
    <div class="flex items-center gap-2.5">
      <svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      <span class="font-sans font-extrabold text-sm sm:text-base tracking-normal uppercase text-neutral-950">Vastra Abharana</span>
      <span class="text-neutral-300 font-bold">•</span>
      <span id="cart-drawer-count" class="text-xs font-sans font-medium text-neutral-500 tracking-normal">
        {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}
      </span>
    </div>

    <button
      onclick="window.closeVastraCart()"
      class="flex items-center gap-1.5 text-xs font-sans font-semibold text-neutral-700 hover:text-orange-600 px-3.5 py-1.5 rounded-full border border-neutral-200 hover:border-orange-500/40 transition-all bg-neutral-50/80 tracking-normal"
    >
      <span>Continue Shopping</span>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- Main Body -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 sm:px-12 py-8 sm:py-10">
    
    <!-- Clean Header with Low Tracking -->
    <div class="mb-6">
      <h1 class="font-sans font-black text-3xl sm:text-4xl text-neutral-950 tracking-tight leading-tight">
        Your Shopping Bag
      </h1>
    </div>

    <!-- Free Delivery Progress Bar -->
    <div class="bg-[#fafafb] p-4 sm:p-5 rounded-xl border border-neutral-200/80 mb-8 max-w-3xl shadow-xs">
      <div class="flex items-center justify-between text-xs sm:text-sm font-sans mb-2.5">
        <span class="text-neutral-700 tracking-normal">Free Express Delivery across India on all handloom orders</span>
        <span class="text-orange-600 font-sans font-bold">100% Free</span>
      </div>
      <div class="w-full h-1.5 bg-neutral-200 rounded-full overflow-hidden">
        <div class="h-full bg-gradient-to-r from-orange-500 via-amber-500 to-orange-600 rounded-full w-full"></div>
      </div>
    </div>

    <!-- 2-Column Shopify Checkout Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
      
      <!-- Cart Items -->
      <div id="cart-items-container" class="lg:col-span-7 space-y-3.5">
        {% for item in cart.items %}
          <div class="flex gap-4 sm:gap-6 items-start bg-white p-4 sm:p-5 rounded-xl border border-neutral-200/90 shadow-xs hover:border-neutral-300 transition-all">
            <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}" class="w-20 sm:w-24 aspect-[3/4] object-cover rounded-md border border-neutral-100 bg-neutral-50 shrink-0">
            <div class="flex-1 min-w-0">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h4 class="font-sans font-bold text-sm sm:text-base text-neutral-950 leading-snug tracking-tight">{{ item.product.title }}</h4>
                  {% unless item.variant.title contains 'Default' %}
                    <p class="text-xs text-neutral-500 font-sans tracking-normal mt-0.5">{{ item.variant.title }}</p>
                  {% endunless %}
                </div>
                <div class="text-right shrink-0">
                  <p class="font-sans font-extrabold text-sm sm:text-base text-neutral-950 tracking-tight">{{ item.final_line_price | money }}</p>
                </div>
              </div>

              <!-- Quantity Controls -->
              <div class="flex items-center justify-between mt-4 pt-3 border-t border-neutral-100">
                <div class="flex items-center border border-neutral-200 rounded-md bg-neutral-50">
                  <button onclick="window.updateQuantity('{{ item.key }}', {{ item.quantity | minus: 1 }})" class="p-1 sm:p-1.5 text-neutral-500 hover:text-neutral-900">-</button>
                  <span class="px-3 text-xs font-sans font-bold text-neutral-900">{{ item.quantity }}</span>
                  <button onclick="window.updateQuantity('{{ item.key }}', {{ item.quantity | plus: 1 }})" class="p-1 sm:p-1.5 text-neutral-500 hover:text-neutral-900">+</button>
                </div>
                <button onclick="window.updateQuantity('{{ item.key }}', 0)" class="text-xs text-neutral-400 hover:text-rose-600 transition-colors font-sans font-medium tracking-normal">Remove</button>
              </div>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Order Summary Card -->
      <div class="lg:col-span-5">
        <div class="bg-[#fafafb] p-6 sm:p-7 rounded-2xl border border-neutral-200/90 sticky top-24 space-y-6 shadow-xs">
          <h3 class="font-sans font-extrabold text-base tracking-tight text-neutral-950 pb-3 border-b border-neutral-200/70">
            Order Summary
          </h3>

          <div class="space-y-3 text-xs sm:text-sm font-sans text-neutral-600">
            <div class="flex justify-between">
              <span>Subtotal</span>
              <span id="cart-drawer-subtotal" class="font-sans font-bold text-neutral-900">{{ cart.total_price | money }}</span>
            </div>
            <div class="flex justify-between">
              <span>Express Delivery</span>
              <span class="font-sans font-bold text-emerald-600">FREE</span>
            </div>
            <div class="flex justify-between items-baseline pt-4 border-t border-neutral-200/80">
              <span class="font-sans font-extrabold text-sm sm:text-base text-neutral-950 tracking-tight">Total Amount</span>
              <span id="cart-drawer-total" class="font-sans font-black text-xl sm:text-2xl text-neutral-950 tracking-tight">{{ cart.total_price | money }}</span>
            </div>
            <p class="text-[11px] text-neutral-400 font-sans tracking-normal">
              Includes all GST & Weaver Handloom Cess. Free door delivery across India.
            </p>
          </div>

          <form action="/checkout" method="post">
            <button
              type="submit"
              name="checkout"
              class="w-full py-3.5 bg-gradient-to-r from-orange-600 to-amber-600 hover:from-orange-500 hover:to-amber-500 text-white font-sans font-bold text-sm tracking-normal rounded-xl flex items-center justify-center gap-2 transition-all shadow-md shadow-orange-500/20 active:scale-98"
            >
              <span>Proceed to Secure Checkout</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
          </form>

          <div class="p-3 bg-emerald-50/70 rounded-xl border border-emerald-200/60 flex items-start gap-2.5">
            <svg class="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <div class="text-[11px] font-sans text-emerald-900 leading-snug tracking-normal">
              <strong class="block font-bold">100% Genuine Silk Mark Certified</strong>
              Direct from Karnataka master weavers with 7-day exchange guarantee.
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>
