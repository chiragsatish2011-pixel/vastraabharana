<section id="catalog" class="py-16 sm:py-24 bg-white border-b border-neutral-100 select-none">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading (Matching Video Frame 22 & 23) -->
    <div class="text-center mb-8 select-none">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-sans font-black uppercase text-neutral-950 tracking-[0.05em] leading-none">
        {{ section.settings.heading | default: 'FEATURED PRODUCTS' }}
      </h2>
      <p class="text-xs sm:text-sm font-sans font-bold uppercase text-neutral-300 tracking-[0.16em] mt-1 select-none opacity-60">
        {{ section.settings.subheading | default: 'FEATURED PRODUCTS' }}
      </p>
    </div>

    <!-- 5-Column Product Grid (Matching Video Frame 24 to 28) -->
    {% assign selected_collection = collections[section.settings.collection] %}
    {% if selected_collection == empty or selected_collection.products_count == 0 %}
      {% assign selected_collection = collections.all %}
    {% endif %}

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 sm:gap-5 lg:gap-6">
      {% for product in selected_collection.products limit: section.settings.products_to_show %}
        <div
          ondblclick="window.location.href='{{ product.url }}'"
          class="group relative bg-white overflow-hidden flex flex-col justify-between transition-all duration-300 select-none cursor-pointer"
          title="Double click to open product"
        >
          <div
            onclick="window.location.href='{{ product.url }}'"
            class="relative aspect-[3/4] overflow-hidden bg-neutral-100/70 rounded-[2px]"
          >
            {% if product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600, crop: 'center' }}"
                alt="{{ product.title | escape }}"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              >
            {% else %}
              <div class="w-full h-full flex items-center justify-center bg-neutral-100 text-neutral-400">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
            {% endif %}

            <div class="absolute top-2.5 left-2.5 z-10 flex flex-col gap-1 items-start">
              <span class="text-[9px] font-sans font-bold uppercase tracking-wider px-2 py-0.5 rounded-[1px] bg-neutral-950 text-white">
                {{ section.settings.badge_text | default: 'NEW' }}
              </span>
            </div>
            
            <!-- Quick Add to Bag on Hover (Matching Video Frame 26) -->
            <div class="absolute inset-x-2.5 bottom-2.5 z-20 flex justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 transform translate-y-1 group-hover:translate-y-0">
              <button
                onclick="event.stopPropagation(); window.vastraAddToCart && window.vastraAddToCart({{ product.variants.first.id }})"
                class="w-full py-2 px-3 rounded-[1px] bg-neutral-950 text-white font-sans font-bold text-xs uppercase tracking-wider shadow-xl hover:bg-orange-600 transition-colors flex items-center justify-center"
              >
                <span>{{ section.settings.quick_add_text | default: 'Select Options' }}</span>
              </button>
            </div>
          </div>

          <div class="pt-2.5 pb-1 space-y-0.5 bg-white">
            <h4 class="text-xs sm:text-[13px] font-sans font-medium text-neutral-800 hover:text-orange-600 transition-colors line-clamp-1">
              <a href="{{ product.url }}">{{ product.title }}</a>
            </h4>
            <div class="flex items-baseline gap-2">
              <span class="text-xs sm:text-[13px] font-sans font-bold text-neutral-950">{{ product.price | money }}</span>
              {% if product.compare_at_price > product.price %}
                <span class="text-[11px] text-neutral-400 line-through font-sans">{{ product.compare_at_price | money }}</span>
              {% endif %}
            </div>
            <div class="flex items-center gap-1.5 pt-0.5">
              <span class="w-2.5 h-2.5 rounded-full border border-neutral-300 bg-neutral-800 inline-block"></span>
              <span class="w-2.5 h-2.5 rounded-full border border-neutral-300 bg-amber-600 inline-block"></span>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Featured Products Catalog",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FEATURED PRODUCTS"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading / Watermark",
      "default": "FEATURED PRODUCTS"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection Source"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of Products to Show",
      "min": 4,
      "max": 25,
      "step": 1,
      "default": 10
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Product Badge",
      "default": "NEW"
    },
    {
      "type": "text",
      "id": "quick_add_text",
      "label": "Button Label",
      "default": "Select Options"
    }
  ],
  "presets": [
    {
      "name": "Featured Products Catalog"
    }
  ]
}
{% endschema %}
