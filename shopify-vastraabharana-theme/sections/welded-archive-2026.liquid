<section id="archive2026" class="welded-archive-section relative w-full h-[110vh] sm:h-[115vh] bg-white select-none border-t border-orange-500/15">

  <!-- CINEMASCOPE STAGE (COMPACT HEIGHT, LETTERBOX PROPORTION) -->
  <div id="archive-sticky-stage" class="sticky top-0 h-[520px] sm:h-[580px] w-full overflow-hidden flex items-center justify-center bg-[#0a0402] shadow-[0_20px_60px_rgba(0,0,0,0.5)]">

    <!-- Top White Shutter Panel (Pristine White #ffffff matching website background) -->
    <div
      id="shutter-top"
      class="absolute top-0 inset-x-0 h-1/2 bg-white z-30 pointer-events-none will-change-transform border-b border-amber-300/40 shadow-[0_12px_30px_rgba(245,158,11,0.06)]"
      style="transform: translate3d(0, 0, 0);"
    >
      <div class="absolute bottom-0 inset-x-0 h-[1.5px] bg-gradient-to-r from-transparent via-amber-400 to-transparent shadow-[0_0_12px_rgba(245,158,11,0.7)]"></div>
    </div>

    <!-- Bottom White Shutter Panel (Pristine White #ffffff matching website background) -->
    <div
      id="shutter-bottom"
      class="absolute bottom-0 inset-x-0 h-1/2 bg-white z-30 pointer-events-none will-change-transform border-t border-amber-300/40 shadow-[0_-12px_30px_rgba(245,158,11,0.06)]"
      style="transform: translate3d(0, 0, 0);"
    >
      <div class="absolute top-0 inset-x-0 h-[1.5px] bg-gradient-to-r from-transparent via-amber-400 to-transparent shadow-[0_0_12px_rgba(245,158,11,0.7)]"></div>
    </div>

    <!-- Center Golden Seam Emblem (Visible when closed, fades smoothly upon scroll) -->
    <div
      id="shutter-seam-emblem"
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-35 pointer-events-none flex flex-col items-center justify-center transition-opacity duration-200"
    >
      <div class="px-4 py-1.5 rounded-full bg-white/95 border border-amber-400/60 shadow-[0_4px_16px_rgba(245,158,11,0.25)] flex items-center gap-2">
        <svg class="w-3.5 h-3.5 text-amber-500 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
        <span class="text-[10px] sm:text-[11px] font-sans font-bold tracking-[0.22em] uppercase text-neutral-800">
          SCROLL TO UNLOCK 2026 ARCHIVE
        </span>
        <svg class="w-3.5 h-3.5 text-amber-500 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
      </div>
    </div>

    <!-- REVEALED FESTIVE ARCHIVE SANCTUM (CINEMASCOPE ATMOSPHERE) -->
    <div
      id="archive-content"
      class="relative w-full max-w-6xl mx-auto px-4 sm:px-8 flex flex-col items-center text-center z-20 will-change-transform py-2 sm:py-4"
      style="transform: scale(0.94); opacity: 0.25;"
    >

      <!-- Warm Radiant Molten Amber & Smoked Charcoal Spotlight Background -->
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_50%,rgba(234,88,12,0.26)_0%,rgba(217,119,6,0.12)_35%,rgba(10,4,2,0.98)_75%)] pointer-events-none -z-10"></div>
      <div class="absolute inset-0 max-w-7xl mx-auto grid grid-cols-4 pointer-events-none divide-x divide-white/[0.04]"></div>

      <!-- HAUTE COUTURE "HAPPY DIWALI" CURSIVE SCRIPT (COMPACT, LOWERED CLOSE ABOVE 2026) -->
      <div class="relative z-10 w-full flex items-center justify-center mt-3 sm:mt-5 mb-0 overflow-visible">
        <h3
          class="italic font-normal text-3xl sm:text-5xl md:text-6xl lg:text-[68px] tracking-wide select-none drop-shadow-[0_8px_30px_rgba(234,88,12,0.50)] overflow-visible inline-block text-center"
          style="background: linear-gradient(135deg, #f59e0b 0%, #fbbf24 35%, #fde047 70%, #d97706 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-family: 'Playfair Display', 'Brush Script MT', cursive, serif; line-height: 1.25; padding-top: 0.1em; padding-bottom: 0.15em;"
        >
          {{ section.settings.script_title | default: 'Happy Diwali' }}
        </h3>
      </div>

      <!-- MASSIVE HIGH-IMPACT 2026 MONUMENT (IMPACT FONT, PURE WHITE RADIANCE, +2PX TRACKING, LINE REMOVED) -->
      <div class="relative my-0 flex items-center justify-center w-full">
        <div class="absolute inset-0 bg-gradient-to-r from-orange-500/25 via-white/30 to-orange-500/25 blur-3xl rounded-full pointer-events-none transform scale-90"></div>

        <div class="relative flex items-center justify-center">
          <span
            class="text-7xl min-[390px]:text-8xl sm:text-[130px] md:text-[160px] lg:text-[185px] xl:text-[210px] leading-none select-none uppercase drop-shadow-[0_20px_50px_rgba(0,0,0,0.95)]"
            style="font-family: Impact, 'Arial Black', sans-serif; font-weight: 900; letter-spacing: 2px; background: linear-gradient(180deg, #FFFFFF 0%, #FFFFFF 62%, #FFFBEB 82%, #FDE68A 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; filter: drop-shadow(0 8px 30px rgba(255,255,255,0.40));"
          >
            {{ section.settings.year_number | default: '2026' }}
          </span>
        </div>
      </div>

      <!-- Archival Trust Statements (Crisp White & Amber on Cinemascope Stage) -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-8 lg:gap-10 mt-2 pt-3 border-t border-white/10 w-full max-w-2xl">
        <div class="flex items-center gap-2 text-[10px] sm:text-xs text-neutral-300 font-sans font-semibold tracking-normal">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          <span>{{ section.settings.badge_1 | default: '100% Silk Mark Certified' }}</span>
        </div>
        <div class="flex items-center gap-2 text-[10px] sm:text-xs text-neutral-300 font-sans font-semibold tracking-normal">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-orange-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
          <span>{{ section.settings.badge_2 | default: 'Direct Weaver Commerce' }}</span>
        </div>
        <div class="flex items-center gap-2 text-[10px] sm:text-xs text-neutral-300 font-sans font-semibold tracking-normal">
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-amber-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
          <span>{{ section.settings.badge_3 | default: 'Pure Gold Zari Weaves' }}</span>
        </div>
      </div>

      <!-- Final Catalog CTA Button -->
      <div class="mt-4 sm:mt-5">
        <a
          href="{{ section.settings.cta_url | default: '/collections/sarees' }}"
          class="inline-flex items-center gap-2.5 px-6 sm:px-8 py-2 sm:py-2.5 bg-orange-600 hover:bg-orange-500 text-white font-sans font-bold text-xs sm:text-sm tracking-normal uppercase rounded-lg transition-all shadow-[0_8px_25px_rgba(234,88,12,0.35)] hover:scale-105 active:scale-95"
        >
          <span>{{ section.settings.cta_label | default: 'DISCOVER THE DIWALI 2026 COLLECTION' }}</span>
          <svg class="w-3.5 h-3.5 text-amber-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>

    </div>

  </div>

</section>

<script>
  (function() {
    var container = document.getElementById('archive2026');
    var topBar = document.getElementById('shutter-top');
    var bottomBar = document.getElementById('shutter-bottom');
    var seamEmblem = document.getElementById('shutter-seam-emblem');
    var content = document.getElementById('archive-content');
    if (!container || !topBar || !bottomBar) return;

    var ticking = false;

    var isUnlocked = false;

    function handleScroll() {
      if (isUnlocked) return;
      if (!ticking) {
        window.requestAnimationFrame(function() {
          var rect = container.getBoundingClientRect();
          var winHeight = window.innerHeight || 800;

          var totalScroll = rect.height - winHeight;
          if (totalScroll <= 0) return;

          var scrolled = -rect.top;
          var rawProgress = Math.min(1, Math.max(0, scrolled / totalScroll));

          // Luxury Quintic Speed Ramp
          var ease = rawProgress < 0.5
            ? 4 * rawProgress * rawProgress * rawProgress
            : 1 - Math.pow(-2 * rawProgress + 2, 3) / 2;

          var translateY = ease * 103;
          var opacity = Math.max(0, 1 - ease * 1.6);

          topBar.style.transform = 'translate3d(0, -' + translateY + '%, 0)';
          bottomBar.style.transform = 'translate3d(0, ' + translateY + '%, 0)';

          if (seamEmblem) {
            seamEmblem.style.opacity = opacity;
            seamEmblem.style.transform = 'translate(-50%, -50%) scale(' + Math.max(0.7, 1 - ease * 0.3) + ')';
            seamEmblem.style.pointerEvents = opacity <= 0.01 ? 'none' : 'auto';
          }

          if (content) {
            var scale = 0.94 + ease * 0.06;
            var contentOpacity = 0.25 + ease * 0.75;
            content.style.transform = 'scale(' + scale + ')';
            content.style.opacity = contentOpacity;
          }

          if (rawProgress >= 0.92 && !isUnlocked) {
            isUnlocked = true;
            topBar.style.display = 'none';
            bottomBar.style.display = 'none';
            if (seamEmblem) seamEmblem.style.display = 'none';
            if (content) {
              content.style.transform = 'scale(1)';
              content.style.opacity = '1';
            }
          }

          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  })();
</script>

{% schema %}
{
  "name": "Welded Archive 2026",
  "settings": [
    {
      "type": "text",
      "id": "script_title",
      "label": "Festive Script Title",
      "default": "Happy Diwali"
    },
    {
      "type": "text",
      "id": "year_number",
      "label": "Year Number",
      "default": "2026"
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Trust Badge 1",
      "default": "100% Silk Mark Certified"
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Trust Badge 2",
      "default": "Direct Weaver Commerce"
    },
    {
      "type": "text",
      "id": "badge_3",
      "label": "Trust Badge 3",
      "default": "Pure Gold Zari Weaves"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "DISCOVER THE DIWALI 2026 COLLECTION"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Welded Archive 2026"
    }
  ]
}
{% endschema %}
