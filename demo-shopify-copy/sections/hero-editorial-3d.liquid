<section class="relative w-full h-screen min-h-[600px] bg-[#0d0604] text-white overflow-hidden select-none flex items-center justify-center pt-[70px] sm:pt-[76px] pb-6">
  
  <!-- Atmospheric Sunset Saffron & Amber Spotlight Background -->
  <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_48%,rgba(234,88,12,0.60)_0%,rgba(217,119,6,0.36)_28%,rgba(180,83,9,0.16)_52%,rgba(13,6,4,0.98)_82%)] pointer-events-none"></div>

  <!-- Subtle Architectural Hairline Grid -->
  <div class="absolute inset-0 max-w-7xl mx-auto grid grid-cols-4 pointer-events-none divide-x divide-white/[0.04]"></div>

  <!-- Falling Petals Canvas -->
  <canvas id="hero-petals-canvas" class="absolute inset-0 w-full h-full pointer-events-none z-[25]"></canvas>

  <!-- Main Hero Stage -->
  <div class="relative w-full h-full flex items-center justify-center max-w-[1500px] mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Layer 1: Typography (Centered as a Crown on Mobile & Tablet) -->
    <div id="hero-text-layer" class="absolute inset-0 flex flex-col items-center justify-start pt-[50px] min-[390px]:pt-[54px] sm:pt-[64px] md:pt-[70px] lg:pt-0 lg:justify-center z-10 pointer-events-none text-center px-4 will-change-transform">
      <h1 class="font-sans font-extrabold text-[30px] min-[390px]:text-[34px] sm:text-[46px] md:text-[54px] lg:text-[104px] xl:text-[116px] uppercase text-white tracking-[0.06em] drop-shadow-[0_8px_32px_rgba(0,0,0,0.90)] leading-none">
        {{ section.settings.title_top | default: 'BE THE' }}
      </h1>
      <h2 class="font-sans font-extrabold text-[30px] min-[390px]:text-[34px] sm:text-[46px] md:text-[54px] lg:text-[104px] xl:text-[116px] uppercase text-white tracking-[0.08em] drop-shadow-[0_12px_45px_rgba(0,0,0,0.98)] leading-none mt-0.5 min-[390px]:mt-1 sm:mt-1.5 lg:mt-3">
        {{ section.settings.title_bottom | default: 'DESI GIRL' }}
      </h2>
    </div>

    <!-- Layer 2: Centerpiece Model (Drastically Enlarged on Mobile, Visible to Abdomen) -->
    <div id="hero-model-layer" class="relative z-20 h-[76vh] sm:h-[72vh] lg:h-[80vh] max-h-[720px] xl:max-h-[760px] flex items-end justify-center pointer-events-none pb-0 mt-3 sm:mt-10 md:mt-16 lg:mt-8 will-change-transform">
      <div class="absolute bottom-0 w-80 sm:w-[480px] h-12 bg-black/70 rounded-[100%] blur-xl pointer-events-none"></div>
      
      <img
        src="{{ 'hero_saree_model_cutout.png' | asset_url }}"
        alt="Vastra Abharana Royal Mysore Silk Model"
        class="h-full w-auto max-h-full object-contain object-bottom filter drop-shadow-[0_25px_50px_rgba(0,0,0,0.85)]"
        fetchpriority="high"
      >

      <!-- Layer 3: Minimal Editorial CTA Button (Single Line Guaranteed) -->
      <div class="absolute bottom-4 sm:bottom-auto sm:top-[58%] left-1/2 -translate-x-1/2 sm:-translate-y-1/2 z-30 pointer-events-auto flex items-center justify-center whitespace-nowrap">
        <a
          href="{{ section.settings.cta_url | default: '#collections' }}"
          class="inline-flex flex-row flex-nowrap items-center justify-center gap-2.5 sm:gap-3 px-6 sm:px-8 py-2.5 sm:py-3 rounded-[2px] bg-neutral-950/90 hover:bg-orange-600 text-white font-sans font-bold text-xs sm:text-sm tracking-[0.16em] uppercase transition-all duration-300 border border-white/50 hover:border-orange-400 shadow-[0_14px_32px_rgba(0,0,0,0.85)] hover:scale-105 active:scale-95 whitespace-nowrap select-none group shrink-0"
        >
          <span class="whitespace-nowrap tracking-[0.16em] text-white font-sans font-bold">{{ section.settings.cta_label | default: 'SHOP NOW' }}</span>
          <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-white group-hover:translate-x-1 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      </div>
    </div>

    <!-- Bottom Vignette: Soft Seamless Blend at Bottom Edge -->
    <div class="absolute bottom-0 inset-x-0 h-20 bg-gradient-to-t from-[#0d0604] to-transparent z-[25] pointer-events-none"></div>

    <!-- Layer 4: 4 Editorial Cards -->
    <div class="hidden lg:block absolute top-8 left-3 lg:left-8 z-15 pointer-events-auto" style="transform: rotate(-5deg)">
      <a href="/collections/sarees" class="block w-44 sm:w-50 lg:w-54 aspect-[3/4] bg-neutral-900 rounded-[2px] shadow-2xl border border-white/15 hover:border-orange-500 hover:scale-105 transition-all overflow-hidden group">
        <img src="{{ 'saris_banner.jpg' | asset_url }}" alt="Mysore Gold Silk" class="w-full h-full object-cover group-hover:scale-106 transition-transform duration-700">
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent p-3 pt-6 flex items-center justify-between">
          <div>
            <p class="text-[10px] font-sans font-bold tracking-[0.16em] uppercase text-white">MYSORE GOLD SILK</p>
            <p class="text-[10px] font-sans text-white/80 font-medium">Handwoven Zari</p>
          </div>
          <span class="text-[11px] font-sans font-bold text-white bg-white/10 px-2 py-0.5 rounded-sm border border-white/20">₹3,850</span>
        </div>
      </a>
    </div>

    <div class="hidden md:block absolute bottom-12 left-4 lg:left-12 z-26 pointer-events-auto" style="transform: rotate(4deg)">
      <a href="/collections/sarees" class="block w-40 sm:w-46 lg:w-50 aspect-[3/4] bg-neutral-900 rounded-[2px] shadow-2xl border border-white/15 hover:border-orange-500 hover:scale-105 transition-all overflow-hidden group">
        <img src="{{ 'model_saree_maroon.jpg' | asset_url }}" alt="Kanjeevaram" class="w-full h-full object-cover group-hover:scale-106 transition-transform duration-700">
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent p-3 pt-6 flex items-center justify-between">
          <div>
            <p class="text-[10px] font-sans font-bold tracking-[0.16em] uppercase text-white">KANJEEVARAM</p>
            <p class="text-[10px] font-sans text-white/80 font-medium">Mulberry Silk</p>
          </div>
          <span class="text-[11px] font-sans font-bold text-white bg-white/10 px-2 py-0.5 rounded-sm border border-white/20">₹6,200</span>
        </div>
      </a>
    </div>

    <div class="hidden lg:block absolute top-10 right-3 lg:right-8 z-15 pointer-events-auto" style="transform: rotate(6deg)">
      <a href="/collections/jewelry" class="block w-44 sm:w-50 lg:w-54 aspect-[3/4] bg-neutral-900 rounded-[2px] shadow-2xl border border-white/15 hover:border-orange-500 hover:scale-105 transition-all overflow-hidden group">
        <img src="{{ 'model_jewelry_detail.jpg' | asset_url }}" alt="Temple Jewelry" class="w-full h-full object-cover group-hover:scale-106 transition-transform duration-700">
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent p-3 pt-6 flex items-center justify-between">
          <div>
            <p class="text-[10px] font-sans font-bold tracking-[0.16em] uppercase text-white">TEMPLE JEWELRY</p>
            <p class="text-[10px] font-sans text-white/80 font-medium">22K Gold Plated</p>
          </div>
          <span class="text-[11px] font-sans font-bold text-white bg-white/10 px-2 py-0.5 rounded-sm border border-white/20">₹2,450</span>
        </div>
      </a>
    </div>

    <div class="hidden md:block absolute bottom-12 right-4 lg:right-12 z-26 pointer-events-auto" style="transform: rotate(-4deg)">
      <a href="/collections/sarees" class="block w-40 sm:w-46 lg:w-50 aspect-[3/4] bg-neutral-900 rounded-[2px] shadow-2xl border border-white/15 hover:border-orange-500 hover:scale-105 transition-all overflow-hidden group">
        <img src="{{ 'hero_model_green.jpg' | asset_url }}" alt="Emerald Raw Silk" class="w-full h-full object-cover group-hover:scale-106 transition-transform duration-700">
        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent p-3 pt-6 flex items-center justify-between">
          <div>
            <p class="text-[10px] font-sans font-bold tracking-[0.16em] uppercase text-white">EMERALD RAW SILK</p>
            <p class="text-[10px] font-sans text-white/80 font-medium">Palace Arch Edition</p>
          </div>
          <span class="text-[11px] font-sans font-bold text-white bg-white/10 px-2 py-0.5 rounded-sm border border-white/20">₹4,850</span>
        </div>
      </a>
    </div>

  </div>

</section>

{% schema %}
{
  "name": "Hero Editorial 3D",
  "settings": [
    {
      "type": "text",
      "id": "title_top",
      "label": "Title Top Line",
      "default": "BE THE"
    },
    {
      "type": "text",
      "id": "title_bottom",
      "label": "Title Bottom Line",
      "default": "DESI GIRL"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Editorial 3D"
    }
  ]
}
{% endschema %}
